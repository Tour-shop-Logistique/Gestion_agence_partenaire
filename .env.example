VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="https://your-api-host.example.com"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Version de l'application (changez cette valeur pour forcer la mise à jour sur toutes les machines)
VITE_APP_VERSION="1.0.0"

# Configuration WebSocket (Laravel Reverb)
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=ws.your-domain.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
