VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="https://your-api-host.example.com"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Version de l'application (changez cette valeur pour forcer la mise à jour sur toutes les machines)
VITE_APP_VERSION="1.0.0"

# Configuration WebSocket (Pusher)
VITE_PUSHER_APP_KEY=your-pusher-app-key
VITE_PUSHER_HOST=ws.your-domain.com
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_PUSHER_APP_CLUSTER=mt1
